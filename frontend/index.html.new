<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>威科夫股票分析系统 - 完整功能版</title>
    <script src="https://cdn.jsdelivr.net/npm/lightweight-charts@4.1.0/dist/lightweight-charts.standalone.production.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Roboto", Arial, sans-serif;
            background: #0a0e27;
            color: #f9fafb;
            min-height: 100vh;
            line-height: 1.6;
            font-size: 14px;
            padding: 20px;
        }
        .container { max-width: 1600px; margin: 0 auto; }
        .card {
            background: #111827;
            border: 1px solid #374151;
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 16px;
        }
        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
            flex-wrap: wrap;
            gap: 12px;
        }
        .card-title { font-size: 16px; font-weight: 600; color: #f9fafb; }
        .form-group { display: flex; gap: 10px; margin-bottom: 12px; align-items: center; flex-wrap: wrap; }
        .form-input {
            padding: 10px 14px;
            background: #1f2937;
            border: 1px solid #374151;
            border-radius: 8px;
            color: #f9fafb;
            font-size: 14px;
        }
        .btn {
            padding: 10px 20px;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .btn-primary {
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            color: white;
        }
        .btn-secondary {
            background: #374151;
            color: #f9fafb;
        }
        
        /* 主图容器 */
        .main-chart-container {
            background: #1f2937;
            border-radius: 10px;
            padding: 12px;
            height: 500px;
            border: 1px solid #374151;
            margin-bottom: 12px;
        }
        
        /* 副图容器 */
        .subchart-container {
            background: #1f2937;
            border-radius: 10px;
            padding: 12px;
            height: 200px;
            border: 1px solid #374151;
            margin-bottom: 12px;
        }
        
        /* 表格容器 */
        .kline-table-container {
            background: #1f2937;
            border-radius: 10px;
            padding: 12px;
            margin-bottom: 16px;
            overflow-x: auto;
            overflow-y: auto;
            border: 1px solid #374151;
            max-height: 800px;
        }
        
        .kline-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
            table-layout: fixed;
            min-width: 1200px;
        }
        .kline-table th,
        .kline-table td {
            padding: 4px 3px;
            text-align: right;
            border-bottom: 1px solid #374151;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .kline-table th {
            font-weight: 600;
            color: #9ca3af;
            font-size: 11px;
            background: #111827;
            position: sticky;
            top: 0;
            z-index: 10;
        }
        .kline-table td:first-child { text-align: left; }
        .kline-red { color: #ef4444; }
        .kline-green { color: #10b981; }
        
        .indicators-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 8px;
        }
        .indicator-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px;
            background: #1f2937;
            border-radius: 8px;
            border: 1px solid #374151;
        }
        .indicator-name { font-size: 12px; color: #9ca3af; }
        .indicator-value { font-size: 14px; font-weight: 600; }
        .indicator-bullish { color: #10b981; }
        .indicator-bearish { color: #ef4444; }
        .indicator-neutral { color: #9ca3af; }
        
        /* Tab导航 */
        .tab-nav {
            display: flex;
            gap: 8px;
            margin-bottom: 16px;
        }
        .tab-btn {
            padding: 8px 16px;
            background: #1f2937;
            border: 1px solid #374151;
            border-radius: 6px;
            color: #9ca3af;
            cursor: pointer;
            font-size: 13px;
        }
        .tab-btn.active {
            background: #3b82f6;
            color: white;
            border-color: #3b82f6;
        }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        
        .chart-toggle { display: flex; gap: 8px; }
        .toggle-btn {
            padding: 8px 14px;
            background: #1f2937;
            border: 1px solid #374151;
            border-radius: 6px;
            color: #9ca3af;
            cursor: pointer;
            font-size: 13px;
        }
        .toggle-btn.active {
            background: #3b82f6;
            color: white;
            border-color: #3b82f6;
        }
        .phase-badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 8px;
            font-size: 10px;
            font-weight: 600;
            margin-left: 4px;
        }
        .phase-A { background: rgba(251, 191, 36, 0.15); color: #fbbf24; border: 1px solid #fbbf24; }
        .phase-U { background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid #10b981; }
        .phase-D { background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid #ef4444; }
        .phase-DS { background: rgba(139, 92, 246, 0.15); color: #8b5cf6; border: 1px solid #8b5cf6; }
        .phase-neutral { background: rgba(156, 163, 175, 0.1); color: #9ca3af; border: 1px solid #374151; }
        
        .loading {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 30px;
            gap: 8px;
        }
        .loading-dot {
            width: 10px;
            height: 10px;
            background: #3b82f6;
            border-radius: 50%;
            animation: loading-bounce 1.4s infinite ease-in-out;
        }
        @keyframes loading-bounce {
            0%, 80%, 100% { transform: scale(0); }
            40% { transform: scale(1); }
        }
        @media (max-width: 768px) {
            .main-chart-container { height: 400px; }
            .subchart-container { height: 180px; }
            .indicators-grid { grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); }
            .kline-table { font-size: 10px; min-width: 1200px; }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Tab导航 -->
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">威科夫股票分析系统</h2>
            </div>
            <div class="tab-nav">
                <button class="tab-btn active" id="tabAnalyze" onclick="showTab('analyze')">分析</button>
                <button class="tab-btn" id="tabWatchlist" onclick="showTab('watchlist')">我的关注</button>
                <button class="tab-btn" id="tabMulti" onclick="showTab('multi')">多周期</button>
                <button class="tab-btn" id="tabConfig" onclick="showTab('config')">系统配置</button>
            </div>

            <!-- 分析Tab -->
            <div id="tab-analyze" class="tab-content active">
                <div class="form-group">
                    <input type="text" class="form-input" id="stockCode" value="688234" placeholder="000001">
                    <select class="form-input" id="timeframe" style="width: 100px;">
                        <option value="daily">日线</option>
                        <option value="weekly">周线</option>
                        <option value="monthly">月线</option>
                    </select>
                    <button class="btn btn-primary" onclick="analyzeStock()">开始分析</button>
                    <button class="btn btn-secondary" onclick="updateStockData()">更新数据</button>
                </div>
                <div id="analyzeResult"></div>
            </div>

            <!-- 我的关注Tab -->
            <div id="tab-watchlist" class="tab-content">
                <div class="card-header">
                    <h2 class="card-title">我的关注</h2>
                    <div class="form-group" style="margin-bottom: 0;">
                        <select class="form-input" id="watchlistSelect" style="width: 120px; margin-right: 10px;" onchange="analyzeFromWatchlist()">
                            <option value="">选择股票</option>
                        </select>
                        <button class="btn btn-primary" onclick="addToWatchlist()">添加</button>
                        <button class="btn btn-secondary" onclick="refreshWatchlist()">刷新</button>
                    </div>
                </div>
                <div id="watchlistContent"></div>
            </div>

            <!-- 多周期Tab -->
            <div id="tab-multi" class="tab-content">
                <div class="card-header">
                    <h2 class="card-title">多周期分析</h2>
                </div>
                <div id="multiContent" style="padding: 20px; color: #9ca3af;">多周期分析功能开发中...</div>
            </div>

            <!-- 系统配置Tab -->
            <div id="tab-config" class="tab-content">
                <div class="card-header">
                    <h2 class="card-title">系统配置</h2>
                </div>
                <div class="indicators-grid" style="padding: 20px;">
                    <div class="indicator-item">
                        <span class="indicator-name">API状态</span>
                        <span class="indicator-value indicator-bullish">运行中</span>
                    </div>
                    <div class="indicator-item">
                        <span class="indicator-name">数据源</span>
                        <span class="indicator-value">akshare</span>
                    </div>
                    <div class="indicator-item">
                        <span class="indicator-name">数据库</span>
                        <span class="indicator-value">SQLite3</span>
                    </div>
                    <div class="indicator-item">
                        <span class="indicator-name">更新频率</span>
                        <span class="indicator-value">每日</span>
                    </div>
                    <div class="indicator-item">
                        <span class="indicator-name">K线数量</span>
                        <span class="indicator-value">300</span>
                    </div>
                    <div class="indicator-item">
                        <span class="indicator-name">威科夫评分</span>
                        <span class="indicator-value">1-10</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- K线图表 -->
        <div class="card" id="klineCard" style="display: none;">
            <div class="card-header">
                <h2 class="card-title">K线图表</h2>
                <div class="chart-toggle">
                    <button class="toggle-btn active" id="btnTable" onclick="showMode('table')">表格</button>
                    <button class="toggle-btn" id="btnChart" onclick="showMode('chart')">图表</button>
                </div>
            </div>

            <!-- 图表模式 -->
            <div id="chartMode" style="display: none;">
                <!-- 主图 -->
                <div class="card-header">
                    <h3 style="font-size: 14px; color: #9ca3af;">主图：K线 + MA5/10/15/30/60/90/120/250（500px）</h3>
                </div>
                <div id="mainChart" class="main-chart-container">
                    <div style="height: 100%; display: flex; align-items: center; justify-content: center; color: #9ca3af;">主图正在加载...</div>
                </div>
                
                <!-- 副图1：成交量 -->
                <div class="card-header">
                    <h3 style="font-size: 14px; color: #9ca3af;">副图1：成交量（200px）</h3>
                </div>
                <div id="volumeChart" class="subchart-container">
                    <div style="height: 100%; display: flex; align-items: center; justify-content: center; color: #9ca3af;">成交量图正在加载...</div>
                </div>
                
                <!-- 副图2：OBV -->
                <div class="card-header">
                    <h3 style="font-size: 14px; color: #9ca3af;">副图2：OBV能量潮（200px）</h3>
                </div>
                <div id="obvChart" class="subchart-container">
                    <div style="height: 100%; display: flex; align-items: center; justify-content: center; color: #9ca3af;">OBV图正在加载...</div>
                </div>
            </div>

            <!-- 表格模式 -->
            <div id="tableMode" class="kline-table-container">
                <table class="kline-table" id="klineTable">
                    <thead>
                        <tr>
                            <th>日期</th>
                            <th>开</th>
                            <th>高</th>
                            <th>低</th>
                            <th>收</th>
                            <th>成交量</th>
                            <th>MA5</th>
                            <th>MA10</th>
                            <th>MA15</th>
                            <th>MA30</th>
                            <th>MA60</th>
                            <th>MA90</th>
                            <th>MA120</th>
                            <th>MA250</th>
                            <th>OBV</th>
                            <th>阶段</th>
                        </tr>
                    </thead>
                    <tbody id="klineBody"></tbody>
                </table>
            </div>
        </div>

        <!-- 技术指标面板 -->
        <div class="card" id="indicatorsCard" style="display: none;">
            <div class="card-header">
                <h2 class="card-title">技术指标</h2>
            </div>
            <div class="indicators-grid" id="indicatorsPanel"></div>
        </div>

        <!-- 威科夫指标面板 -->
        <div class="card" id="wyckoffCard" style="display: none;">
            <div class="card-header">
                <h2 class="card-title">威科夫指标</h2>
            </div>
            <div class="indicators-grid" id="wyckoffPanel"></div>
        </div>
    </div>

    <script>
        const API_BASE = 'http://45.153.246.2:8000';
        let currentQuotesData = null;
        let currentAnalysisData = null;
        let useTableMode = true;
        let mainChart = null;
        let volumeChart = null;
        let obvChart = null;

        // Tab切换
        function showTab(tab) {
            const tabs = ['analyze', 'watchlist', 'multi', 'config'];
            tabs.forEach(t => {
                document.getElementById(`tab-${t}`).classList.remove('active');
                document.getElementById(`tab-${t.charAt(0).toUpperCase()}${t.slice(1)}`).classList.remove('active');
                document.getElementById(`tab-${t.charAt(0).toUpperCase()}${t.slice(1)}`).style.display = 'none';
            });
            document.getElementById(`tab-${tab}`).classList.add('active');
            document.getElementById(`tab-${tab}`).style.display = 'block';
        }

        // 显示模式切换
        function showMode(mode) {
            const btnTable = document.getElementById('btnTable');
            const btnChart = document.getElementById('btnChart');
            const tableMode = document.getElementById('tableMode');
            const chartMode = document.getElementById('chartMode');

            if (mode === 'table') {
                btnTable.classList.add('active');
                btnChart.classList.remove('active');
                tableMode.style.display = 'block';
                chartMode.style.display = 'none';
                useTableMode = true;
            } else {
                btnChart.classList.add('active');
                btnTable.classList.remove('active');
                tableMode.style.display = 'none';
                chartMode.style.display = 'block';
                useTableMode = false;
                renderCharts();
            }
        }

        // 计算MA（按时间顺序，最新的有所有值）
        function calculateMA(data, period) {
            const ma = [];
            for (let i = 0; i < data.length; i++) {
                if (i < period - 1) {
                    ma.push(null);
                } else {
                    let sum = 0;
                    for (let j = 0; j < period; j++) {
                        sum += data[i - j];
                    }
                    ma.push(sum / period);
                }
            }
            return ma;
        }

        function calculateEMA(data, period) {
            const k = 2 / (period + 1);
            let ema = [data[0]];
            for (let i = 1; i < data.length; i++) {
                ema.push(data[i] * k + ema[i - 1] * (1 - k));
            }
            return ema;
        }

        function renderCharts() {
        function renderKlineTable(quotes) {
            const klineBody = document.getElementById('klineBody');

            if (!quotes || quotes.length === 0) {
                klineBody.innerHTML = '';
                return;
            }

            // 直接使用后端返回的均线值，不再前端计算
            // 反转数据，让最新的在上面
            klineBody.innerHTML = quotes.slice().reverse().slice(0, 100).map((q, i) => {
                const isRed = q.close < q.open;
                const closeClass = isRed ? 'kline-red' : 'kline-green';

                let phase = '震荡';
                let phaseClass = 'phase-neutral';

                // 使用后端返回的ma5, ma10, ma20
                if (q.ma20 && q.ma5 > q.ma10 && q.ma10 > q.ma20 && q.close > q.ma20) {
                    phase = 'U'; phaseClass = 'phase-U';
                } else if (q.ma20 && q.ma5 < q.ma10 && q.ma10 < q.ma20 && q.close < q.ma20) {
                    phase = 'D'; phaseClass = 'phase-D';
                } else if (q.volume && q.volume_ma5 && q.volume > q.volume_ma5 * 1.5) {
                    phase = 'A'; phaseClass = 'phase-A';
                } else if (q.ma5 && q.ma20 && q.close < q.ma5 && q.close > q.ma20) {
                    phase = 'DS'; phaseClass = 'phase-DS';
                }

                return `
                    <tr>
