        // 添加威科夫指标标记
        function addWyckoffIndicators(chart, candleSeries, quotes, analysis) {
            if (!quotes || quotes.length === 0) return;

            try {
                const latestQuote = quotes[quotes.length - 1];
                const recentQuotes = quotes.slice(-30);
                const highs = recentQuotes.map(q => q.high);
                const lows = recentQuotes.map(q => q.low);
                const supportLevel = Math.min(...lows);
                const resistanceLevel = Math.max(...highs);

                // 支撑位
                candleSeries.createPriceLine({
                    price: supportLevel,
                    color: '#10b981',
                    lineWidth: 2,
                    lineStyle: 2,
                    axisLabelVisible: true,
                    title: '支撑'
                });

                // 阻力位
                candleSeries.createPriceLine({
                    price: resistanceLevel,
                    color: '#ef4444',
                    lineWidth: 2,
                    lineStyle: 2,
                    axisLabelVisible: true,
                    title: '阻力'
                });

                // 信号点
                const markers = [];
                const signalQuotes = quotes.slice(-50);

                signalQuotes.forEach((q, index) => {
                    if (index === 0) return;
                    const prev = signalQuotes[index - 1];

                    // 异常成交量标记
                    if (q.volume > q.volume_ma5 * 2) {
                        const isBullish = q.close > prev.close;
                        markers.push({
                            time: q.date,
                            position: isBullish ? 'belowBar' : 'aboveBar',
                            color: isBullish ? '#10b981' : '#ef4444',
                            shape: 'circle',
                            text: '🔥'
                        });
                    }

                    // MA15金叉/死叉
                    const ma15Cross = (prev.ma15 < prev.ma30 && q.ma15 > q.ma30) || (prev.ma15 > prev.ma30 && q.ma15 < q.ma30);
                    if (ma15Cross) {
                        const isGolden = q.ma15 > q.ma30;
                        markers.push({
                            time: q.date,
                            position: 'belowBar',
                            color: isGolden ? '#10b981' : '#ef4444',
                            shape: 'circle',
                            text: '⚡'
                        });
                    }
                });

                // 当前方向标记
                if (analysis && analysis.direction) {
                    if (analysis.direction === 'LONG') {
                        markers.push({
                            time: latestQuote.date,
                            position: 'belowBar',
                            color: '#10b981',
                            shape: 'arrowUp',
                            text: '📈'
                        });
                    } else if (analysis.direction === 'SHORT') {
                        markers.push({
                            time: latestQuote.date,
                            position: 'aboveBar',
                            color: '#ef4444',
                            shape: 'arrowDown',
                            text: '📉'
                        });
                    }
                }

                if (markers.length > 0) {
                    candleSeries.setMarkers(markers);
                    console.log('添加威科夫标记: 支撑位、阻力位、信号点');
                }

            } catch (error) {
                console.error('添加威科夫指标失败:', error);
            }
        }

        function updatePhaseTag() {
            if (!currentQuotesData || currentQuotesData.length === 0) return;

            const latestQuote = currentQuotesData[currentQuotesData.length - 1];
            let phase = '震荡';
            let phaseClass = 'phase-neutral';
            let phaseTooltip = '横盘整理，等待方向选择';

            if (latestQuote.close > latestQuote.ma20 && latestQuote.ma5 > latestQuote.ma10 && latestQuote.ma10 > latestQuote.ma20) {
                phase = 'U';
                phaseClass = 'phase-U';
                phaseTooltip = '上升趋势，均线多头排列，价格强势';
