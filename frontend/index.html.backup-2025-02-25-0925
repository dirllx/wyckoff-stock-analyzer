            addLog('形态识别', `股票代码: ${code}, 周期: ${timeframe}`);

            try {
                const response = await fetch(`${API_BASE}/api/v1/stocks/${code}/patterns?timeframe=${timeframe}`);
                const data = await response.json();

                console.log('形态识别结果:', data);

                const content = document.getElementById('patternResult');

                if (!data || !data.patterns || data.patterns.length === 0) {
                    content.innerHTML = '<div style="text-align:center; color:#9ca3af; padding:20px;">未识别到任何形态</div>';
                    addLog('识别完成', '未识别到任何形态');
                    return;
                }

                let html = `<div style="margin-bottom: 12px; color: #f9fafb;">共识别到 ${data.total} 种形态：</div>`;
                html += '<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 12px;">';

                data.patterns.forEach(pattern => {
                    const confidenceClass = pattern.confidence >= 0.7 ? 'indicator-bullish' : pattern.confidence >= 0.5 ? 'indicator-neutral' : 'indicator-bearish';

                    html += `
                        <div style="background: #1f2937; border: 1px solid #374151; border-radius: 8px; padding: 12px;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                                <span style="font-weight: 600;">${pattern.pattern_name}</span>
                                <span class="indicator-value ${confidenceClass}">${(pattern.confidence || 0) * 100}%</span>
                            </div>
                            <div style="font-size: 12px; color: #9ca3af; margin-bottom: 6px;">类型: ${pattern.pattern_type}</div>
                            <div style="font-size: 12px; color: #9ca3af; margin-bottom: 6px;">信号: ${pattern.signal || '无'}</div>
                            <div style="font-size: 12px; color: #9ca3af;">日期: ${pattern.date || '-'}</div>
                            ${pattern.description ? `<div style="margin-top: 8px; padding: 8px; background: #0a0e27; border-radius: 6px; font-size: 12px; color: #d1d5db;">${pattern.description}</div>` : ''}
                        </div>
                    `;
                });

                html += '</div>';
                content.innerHTML = html;
                addLog('识别完成', `共识别 ${data.total} 种形态`);
            } catch (error) {
                console.error('形态识别失败:', error);
                document.getElementById('patternResult').innerHTML = `<div style="text-align:center; color:#ef4444; padding:20px;">识别失败: ${error.message}</div>`;
                addLog('识别失败', `错误: ${error.message}`);
            }
        }

        function updateTestStatus(test, result, message) {
            const statusTab = document.getElementById('tab-status');
            if (statusTab) {
                let currentHtml = statusTab.innerHTML;
                const color = result ? 'green' : 'red';
                const icon = result ? '✓' : '✗';
                const time = new Date().toLocaleTimeString('zh-CN', { hour12: false });
                const line = `<div style="padding: 8px 0; border-bottom: 1px solid #374151;">
                    <span style="color: #999;">[${time}]</span>
                    <span style="color: ${color}; margin: 0 10px;">${icon}</span>
                    <strong>${test}:</strong> ${message}
                </div>`;
                statusTab.innerHTML = line + currentHtml;
            }
        }

        // 页面加载完成时刷新关注列表
        window.addEventListener('load', () => {
            console.log('页面加载完成');
            // 暂时禁用自动刷新，测试是否是这里导致的问题
            // refreshWatchlist();
            console.log('刷新关注列表已禁用');
        });
    </script>

    <!-- 测试状态Tab -->
    <div id="tab-status" class="tab-content">
        <div style="padding: 20px; color: #9ca3af;">这里是测试结果汇总区域...</div>
    </div>

    <!-- 日志区域 -->
    <div class="card" style="margin-top: 20px;">
        <div class="card-header">
            <h2 class="card-title">操作日志</h2>
            <button class="btn btn-secondary" style="float: right; padding: 6px 12px; font-size: 12px;" onclick="toggleLog()">收起/展开</button>
        </div>
        <div id="logArea" style="height: 300px; overflow-y: auto; padding: 15px; background: #0a0e27; border-radius: 8px; font-family: 'Courier New', monospace; font-size: 12px; line-height: 1.6;">
            <div style="color: #9ca3af;">等待操作...</div>
        </div>
    </div>
</body>
</html>
