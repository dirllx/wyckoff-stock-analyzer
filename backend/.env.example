# 威科夫股票分析系统 - 环境变量配置模板
# 复制此文件为 .env 并根据实际环境修改配置值

# ================================
# 应用配置
# ================================

# 调试模式（开发环境设为True，生产环境设为False）
DEBUG=False

# API服务配置
API_HOST=0.0.0.0
API_PORT=8000

# ================================
# 数据库配置
# ================================

# SQLite数据库文件路径
# SQLite: sqlite:///./wyckoff.db
# PostgreSQL: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=sqlite:///./wyckoff.db

# ================================
# Redis配置
# ================================

# Redis连接URL
# 格式: redis://localhost:6379/0
# 或带密码: redis://:password@localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ================================
# 第三方API密钥（可选）
# ================================

# Tushare数据接口Token（可选）
# 获取地址: https://tushare.pro/register
TUSHARE_TOKEN=

# 飞书机器人Webhook URL（可选）
# 用于发送威科夫分析通知
FEISHU_WEBHOOK_URL=

# ================================
# 前端配置
# ================================

# 前端服务端口
FRONTEND_PORT=3000

# ================================
# 日志配置
# ================================

# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ================================
# 部署说明
# ================================

# 开发环境:
# - 使用默认配置即可
# - DEBUG=True
# - API_PORT=8000

# 生产环境:
# - 修改DEBUG=False
# - 使用强密码
# - 配置HTTPS和反向代理
# - 使用PostgreSQL替代SQLite
# - 配置Redis持久化

# Docker部署:
# - 使用docker-compose.yml配置
# - 通过环境变量传递配置
# - 挂载数据卷实现数据持久化
